  "afirmaciones": [
    {"dato": "Donald Unger se tronó los nudillos de la mano izquierda (no la derecha) por más de 60 años, al menos dos veces al día, y no encontró artritis en ninguna.",
     "fuente": "Unger DL. Does knuckle cracking lead to arthritis of the fingers? Arthritis & Rheumatism 1998;41(5):949-950", "estado": "verificado"},
    {"dato": "Ganó el Ig Nobel de Medicina 2009.", "fuente": "https://improbable.com/2009/11/05/interview-with-dr-knuckle-cracker/", "estado": "verificado"},
    {"dato": "Resonancia magnética en tiempo real: el crack coincide con la formación de una cavidad de gas, en menos de 310 ms.",
     "fuente": "Kawchuk GN et al. Real-Time Visualization of Joint Cavitation. PLoS ONE 2015. doi:10.1371/journal.pone.0119470", "estado": "verificado"},
    {"dato": "Modelo matemático: el sonido se explicaría por el colapso parcial de la burbuja.",
     "fuente": "Chandran Suja V, Barakat AI. A Mathematical Model for the Sounds Produced by Knuckle Cracking. Scientific Reports 2018;8:4600", "estado": "verificado"},
    {"dato": "El experimento de Unger es de una sola persona: no es prueba definitiva.", "fuente": "Limitación metodológica (n = 1)", "estado": "verificado"}
  ],

  "narracion": [
    {"t": [0.2, 4.0], "txt": "Este hombre se tronó los dedos de una sola mano… durante sesenta años.", "nota": "Gancho: énfasis en 'una sola'. Sin saludo."},
    {"t": [4.1, 6.6], "txt": "Todo para llevarle la contraria a su mamá."},
    {"t": [6.7, 9.3], "txt": "Ella le decía: «te va a dar artritis».", "nota": "Imitar el tono de mamá, breve."},
    {"t": [9.5, 11.6], "txt": "Pero antes: ¿qué es ese crack?"},
    {"t": [11.8, 16.2], "txt": "Entre tus huesos hay un líquido, el líquido sinovial, con gases disueltos."},
    {"t": [16.4, 20.0], "txt": "Cuando jalas el dedo, los huesos se separan y la presión cae."},
    {"t": [20.1, 23.6], "txt": "En menos de un tercio de segundo aparece una cavidad de gas."},
    {"t": [23.8, 26.6], "txt": "Así lo grabaron con resonancia magnética en 2015.", "nota": "Decir 'dos mil quince'."},
    {"t": [26.8, 29.2], "txt": "Lo que aún se discute es el sonido."},
    {"t": [29.3, 32.6], "txt": "¿Sale cuando se forma la burbuja… o cuando colapsa en parte?"},
    {"t": [33.0, 35.6], "txt": "¿Y la mamá? Después de sesenta años…"},
    {"t": [35.7, 38.6], "txt": "ninguna de sus dos manos tenía artritis."},
    {"t": [38.8, 42.0], "txt": "Lo publicó en 1998 y ganó un Ig Nobel.", "nota": "Decir 'mil novecientos noventa y ocho'."},
    {"t": [42.2, 45.0], "txt": "Ojo: es una sola persona, no una prueba definitiva."},
    {"t": [45.2, 47.7], "txt": "Ahora mira tus manos: ¿cuál es la de control?", "nota": "Cierre en loop: vuelve a las dos manos del inicio."}
  ],

